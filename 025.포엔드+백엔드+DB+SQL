### 3. 서비스 통합 설정 (`compose.yaml`)

```yaml
services:
  nginx:
    build: ./frontend
    ports:
      - "80:80"
    depends_on:
      - backend

  backend:
    build: ./backend
    environment:
      - DB_HOST=db
      - DB_NAME=employees
      - DB_USER=admin
      - DB_PASSWORD=admin123
    depends_on: --의존성
      db:
        condition: service_healthy (컨디션 헬스가 트루 아니면 하지마라)

  db:
    image: mysql:8.0
    environment:
      - MYSQL_DATABASE(mysql 변수명)=employees --그 변수명을 emloyees에 넣어라
      - MYSQL_ROOT_PASSWORD=root_pass
      - MYSQL_USER=admin
      - MYSQL_PASSWORD=admin123
    volumes:
      - ./db/employees.sql:/docker-entrypoint-initdb.d/employees.sql
      - mysql_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  mysql_data:
ㅇ
```

